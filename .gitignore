# Common Python ignores
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Video and Audio files (Exclude data video)
*.mp4
*.avi
*.mkv
*.mov
*.flv
*.wmv
*.webm
*.wav
*.mp3
*.m4a

# Data folder handling (keep repo lightweight)
# Ignore everything under data by default
data/**

# Re-include only lightweight metadata/list artifacts
!data/metadata/
!data/metadata/*.csv
!data/lists/
!data/lists/*.csv
!data/lists/*.txt

# Ignore heavy output/temporary folders
legacy/
test_Dat/
classifier_thumbnail/

# Ignore models and checkpoints
*.pth
*.h5
*.weights
*.onnx
*.pt
*.ckpt

# Logs and experiment artifacts
*.log
logs/
wandb/
runs/
tensorboard/

# Notebook and editor caches
.ipynb_checkpoints/
.vscode/

# Archive/compressed files
*.zip
*.tar
*.tar.gz
*.tgz

# Keep final reports and benchmark tables under results
!results/final_reports/*.md
!results/final_reports/*.csv
!results/production_parallel_methods/*.csv
!results/retrieval_parallel_methods/**/*.md
!results/retrieval_parallel_methods/**/*.csv
